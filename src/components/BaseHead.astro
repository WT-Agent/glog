---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	article?: {
		pubDate?: Date;
		updatedDate?: Date;
		author?: string;
	};
}

const siteURL = Astro.site ?? new URL('https://geniux.net');
const canonicalURL = new URL(Astro.url.pathname, siteURL);

const { title, description, image = FallbackImage, article } = Astro.props;
const imagePath = typeof image === 'string' ? image : (image?.src || FallbackImage.src);
const imageURL = new URL(imagePath, siteURL);

// Base Website & Identity Structured Data
const jsonLdGraph: any[] = [
	{
		"@type": "WebSite",
		"@id": new URL('#website', siteURL).toString(),
		"url": siteURL.toString(),
		"name": "闲话 & AI | geniux.net",
		"alternateName": ["geniux.net", "Geniux", "Geniux Blog", "尹鸿文个人主页"],
		"description": "尹鸿文 (Geniux · 字霂之 · 号霈泽) 个人主页与最新文章",
		"inLanguage": ["zh-CN", "en"]
	},
	{
		"@type": "Person",
		"@id": new URL('#person', siteURL).toString(),
		"name": "尹鸿文",
		"alternateName": ["Geniux", "霂之", "霈泽", "霄枻", "尹博睿"],
		"url": siteURL.toString(),
		"sameAs": [
			"https://x.com/geniux",
			"https://github.com/WT-Agent",
			"https://blogger.geniux.net",
			"https://about.me/geniux"
		],
		"jobTitle": "Architect & Founder"
	}
];

if (article) {
	jsonLdGraph.push({
		"@type": "BlogPosting",
		"@id": canonicalURL.toString(),
		"mainEntityOfPage": {
			"@type": "WebPage",
			"@id": canonicalURL.toString()
		},
		"headline": title,
		"description": description,
		"image": imageURL.toString(),
		"datePublished": article.pubDate ? new Date(article.pubDate).toISOString() : undefined,
		"dateModified": (article.updatedDate || article.pubDate) ? new Date(article.updatedDate || article.pubDate).toISOString() : undefined,
		"author": {
			"@type": "Person",
			"name": article.author || "尹鸿文",
			"url": siteURL.toString()
		},
		"publisher": {
			"@type": "Person",
			"name": "尹鸿文",
			"url": siteURL.toString()
		}
	});
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', siteURL)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Google Search Console Verification (Optional environment injection) -->
{import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
	<meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />

<!-- Structured Data (JSON-LD) for Search Engines & Knowledge Graph -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@graph": jsonLdGraph
})} />

<ClientRouter />

<script is:inline>
	(() => {
		const detectLang = () => {
			const navLang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
			return navLang.startsWith('zh') ? 'zh' : 'en';
		};

		const applyLang = () => {
			const lang = detectLang();
			document.documentElement.dataset.lang = lang;
			document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
		};

		const applyLangAttrs = () => {
			const lang = document.documentElement.dataset.lang || detectLang();
			document.querySelectorAll('[data-title-zh][data-title-en]').forEach((el) => {
				const val = el.getAttribute(`data-title-${lang}`);
				if (val) el.setAttribute('title', val);
			});
			document.querySelectorAll('[data-aria-zh][data-aria-en]').forEach((el) => {
				const val = el.getAttribute(`data-aria-${lang}`);
				if (val) el.setAttribute('aria-label', val);
			});
		};

		applyLang();
		document.addEventListener('astro:after-swap', applyLang);
		document.addEventListener('astro:page-load', () => {
			applyLang();
			applyLangAttrs();
		});
	})();
</script>
