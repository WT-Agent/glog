---
import Button from './ui/Button.astro';

const { blogPostId, showDetails = false } = Astro.props;

const { getConversionProgress } = await import('../lib/podcast/index.mjs');

let podcastStatus = null;

try {
  podcastStatus = await getConversionProgress(blogPostId);
} catch (error) {
  console.error('获取播客状态失败:', error);
}

const getStageStatus = (stage: { status: string }) => {
  if (stage?.status === 'completed') return '✓';
  if (stage?.status === 'in_progress') return '⟳';
  return '○';
};
---

{podcastStatus && (
  <div class="my-6">
    <div class:list={[
      "p-5 rounded-xl border border-border bg-card text-card-foreground shadow-xs transition-all duration-200",
      podcastStatus.status === 'processing' && "border-l-4 border-l-primary",
      podcastStatus.status === 'completed' && "border-l-4 border-l-emerald-500",
      podcastStatus.status === 'failed' && "border-l-4 border-l-destructive",
      podcastStatus.status === 'pending' && "border-l-4 border-l-muted-foreground/40"
    ]}>
      <div class="flex items-center gap-3 font-semibold text-sm">
        <span class="text-xs uppercase tracking-wider text-muted-foreground">Status:</span>
        <span class="text-foreground">
          {podcastStatus.status === 'processing' && '播客转换中...'}
          {podcastStatus.status === 'completed' && '播客已发布'}
          {podcastStatus.status === 'failed' && '播客转换失败'}
          {podcastStatus.status === 'pending' && '等待转换'}
        </span>
      </div>

      {podcastStatus.status === 'processing' && (
        <div class="mt-4">
          <div class="w-full h-2 bg-muted rounded-full overflow-hidden">
            <div 
              class="h-full bg-primary transition-all duration-300" 
              style={`width: ${podcastStatus.progress}%`}
            ></div>
          </div>
          <div class="text-right text-xs text-muted-foreground mt-1.5 font-mono">{podcastStatus.progress}%</div>
        </div>
      )}

      {podcastStatus.status === 'completed' && podcastStatus.result && (
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <Button href={podcastStatus.result.audioUrl} variant="primary" size="sm" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"></path><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
            收听播客
          </Button>
          {podcastStatus.result.duration && (
            <span class="text-xs text-muted-foreground font-medium">
              时长: {podcastStatus.result.duration.minutes} 分钟
            </span>
          )}
        </div>
      )}

      {podcastStatus.status === 'failed' && podcastStatus.error && (
        <div class="mt-3">
          <p class="text-xs text-destructive font-medium">{podcastStatus.error}</p>
        </div>
      )}

      {showDetails && podcastStatus.stages && (
        <div class="mt-4 pt-4 border-t border-border">
          <h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">转换进度</h4>
          <ul class="space-y-1 text-xs text-foreground font-mono">
            <li class="flex items-center gap-2">
              <span class="w-4 text-center font-bold">{getStageStatus(podcastStatus.stages.contentProcessing)}</span>
              <span>内容处理</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-4 text-center font-bold">{getStageStatus(podcastStatus.stages.audioGeneration)}</span>
              <span>音频生成</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-4 text-center font-bold">{getStageStatus(podcastStatus.stages.audioDownload)}</span>
              <span>音频下载</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-4 text-center font-bold">{getStageStatus(podcastStatus.stages.validation)}</span>
              <span>质量验证</span>
            </li>
          </ul>
        </div>
      )}

      <div class="mt-3 pt-2 border-t border-border/40">
        <span class="text-[11px] text-muted-foreground/70">
          更新于: {new Date(podcastStatus.updatedAt).toLocaleString('zh-CN')}
        </span>
      </div>
    </div>
  </div>
)}
