<div id="cookie-consent" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-[100] w-[calc(100%-2rem)] max-w-2xl hidden">
	<div class="px-4 py-3 rounded-xl shadow-lg border border-border bg-card/95 text-card-foreground backdrop-blur-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
		<p class="text-xs text-muted-foreground leading-relaxed">
			<span class="lang-zh">本站使用必要 Cookie 以优化浏览体验与基础访问统计。</span>
			<span class="lang-en">This site uses essential cookies to enhance browsing experience and basic analytics.</span>
		</p>
		<div class="flex items-center gap-2 shrink-0">
			<button id="decline-cookies" class="px-3 py-1.5 rounded-lg bg-muted hover:bg-muted/80 text-foreground border border-border/60 font-medium text-xs active:scale-[0.98] transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-ring">
				<span class="lang-zh">拒绝</span>
				<span class="lang-en">Decline</span>
			</button>
			<button id="accept-cookies" class="px-3 py-1.5 rounded-lg bg-primary text-primary-foreground font-medium text-xs hover:opacity-90 active:scale-[0.98] transition-all cursor-pointer shadow-xs focus-visible:outline-2 focus-visible:outline-ring">
				<span class="lang-zh">接受</span>
				<span class="lang-en">Accept</span>
			</button>
		</div>
	</div>
</div>

<script>
	const consent = document.getElementById('cookie-consent');
	const acceptBtn = document.getElementById('accept-cookies');
	const declineBtn = document.getElementById('decline-cookies');

	if (!localStorage.getItem('cookie-consent')) {
		consent?.classList.remove('hidden');
		consent?.classList.add('animate-in', 'fade-in', 'slide-in-from-bottom-4', 'duration-500');
	}

	acceptBtn?.addEventListener('click', () => {
		localStorage.setItem('cookie-consent', 'accepted');
		consent?.classList.add('animate-out', 'fade-out', 'slide-out-to-bottom-4', 'duration-300');
		setTimeout(() => consent?.classList.add('hidden'), 300);
	});

	declineBtn?.addEventListener('click', () => {
		localStorage.setItem('cookie-consent', 'declined');
		consent?.classList.add('animate-out', 'fade-out', 'slide-out-to-bottom-4', 'duration-300');
		setTimeout(() => consent?.classList.add('hidden'), 300);
	});
</script>
