---
export const prerender = true;
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Pagination from '../../components/Pagination.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { PROJECTS, getRelatedPostsForProject } from '../../data/projects';
import { getSortedBlogPosts } from '../../lib/content';

export async function getStaticPaths({ paginate }) {
	return paginate(PROJECTS, { pageSize: 6 });
}

const { page } = Astro.props;
const projects = page.data;
const allPosts = await getSortedBlogPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-background text-foreground antialiased font-sans selection:bg-brand/10 selection:text-brand transition-colors duration-300">
		<Header />
		<main class="w-full max-w-4xl lg:max-w-5xl xl:max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-12 md:py-20 relative overflow-hidden transition-all duration-300">
			<!-- Abstract Background -->
			<div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand/5 blur-[120px] rounded-full -z-10 translate-x-1/2 -translate-y-1/2"></div>
			
			<div class="space-y-16">
				<!-- Header Section -->
				<header class="max-w-3xl space-y-6 animate-in fade-in slide-in-from-bottom-8 duration-1000">
					<h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight">
						Crafting <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand to-brand-dark">Futures</span>
					</h1>
					<p class="lang-zh text-xl md:text-2xl text-muted-foreground font-light leading-relaxed">
						基于 AI Agentic 的 SaaS 平台、视频引擎、游戏引擎等。
					</p>
					<p class="lang-en text-xl md:text-2xl text-muted-foreground font-light leading-relaxed">
						AI Agentic-based SaaS platforms, video engines, game engines, and more.
					</p>
				</header>

				<!-- Schematic Grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-muted/10 border border-muted/20 rounded-3xl overflow-hidden animate-in fade-in slide-in-from-bottom-12 duration-1000 delay-200">
					{projects.map((project) => {
						const relatedEssays = getRelatedPostsForProject(project, allPosts, 2);
						return (
						<div class="group relative bg-card/40 p-8 md:p-10 hover:bg-card/80 transition-colors duration-500">
							<!-- Category & Status -->
							<div class="flex justify-between items-start mb-8">
								<div class="flex items-center gap-3">
									<span class="text-[10px] font-black uppercase tracking-[0.2em] text-brand/60 italic">
										{project.zhCategory ? (
											<>
												<span class="lang-zh">{project.zhCategory}</span>
												<span class="lang-en">{project.category}</span>
											</>
										) : (
											project.category
										)}
									</span>
								</div>
								
								{(project.status === 'Active' || project.status === 'Live') && (
									<div class="flex items-center gap-2">
										<span class="relative flex h-1.5 w-1.5">
											<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
											<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
										</span>
										<span class="text-[9px] font-black uppercase tracking-widest text-emerald-500/80 italic">
											<span class="lang-zh">{project.status === 'Live' ? '上线中' : '进行中'}</span>
											<span class="lang-en">{project.status}</span>
										</span>
									</div>
								)}
								{project.status === 'Divested' && (
									<div class="flex items-center gap-2">
										<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-500"></span>
										<span class="text-[9px] font-black uppercase tracking-widest text-amber-500/80 italic">
											<span class="lang-zh">已剥离</span>
											<span class="lang-en">Divested</span>
										</span>
									</div>
								)}
								{project.status === 'Legacy' && (
									<div class="flex items-center gap-2">
										<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-muted-foreground/60"></span>
										<span class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/60 italic">
											<span class="lang-zh">已归档</span>
											<span class="lang-en">Legacy</span>
										</span>
									</div>
								)}
							</div>

							<!-- Title & Description -->
							<div class="space-y-4">
								<h3 class="text-2xl md:text-3xl font-black tracking-tight group-hover:text-brand transition-all duration-500">
									{project.link ? (
										<a href={project.link} target="_blank" class="flex items-center gap-3 w-fit">
											{project.zhTitle ? (
												<>
													<span class="lang-zh">{project.zhTitle}</span>
													<span class="lang-en">{project.enTitle || project.title}</span>
												</>
											) : (
												project.title
											)}
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand/30 group-hover:text-brand opacity-0 group-focus:opacity-100 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-500 shrink-0"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
										</a>
									) : (
										project.zhTitle ? (
											<>
												<span class="lang-zh">{project.zhTitle}</span>
												<span class="lang-en">{project.enTitle || project.title}</span>
											</>
										) : (
											project.title
										)
									)}
								</h3>
								<p class="text-muted-foreground leading-relaxed text-sm md:text-base font-normal max-w-lg">
									{project.zhDescription ? (
										<>
											<span class="lang-zh">{project.zhDescription}</span>
											<span class="lang-en">{project.enDescription || project.zhDescription}</span>
										</>
									) : (
										project.description
									)}
								</p>
							</div>

							<!-- Tech Stack (Tags) -->
							<div class="mt-8 flex flex-wrap gap-x-4 gap-y-2">
								{project.tags.map((tag) => (
									<span class="font-mono text-[10px] text-muted-foreground/40 hover:text-brand transition-colors uppercase tracking-widest">
										// {tag}
									</span>
								))}
							</div>

							{relatedEssays.length > 0 && (
								<div class="mt-5 pt-4 border-t border-border/40 space-y-1.5">
									<div class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
										<span class="lang-zh">关联文章</span>
										<span class="lang-en">Related Essays</span>
									</div>
									<div class="flex flex-col gap-1">
										{relatedEssays.map((essay) => (
											<a
												href={`/blog/${essay.id}/`}
												class="text-xs text-muted-foreground hover:text-primary transition-colors truncate block"
												title={essay.data.title}
											>
												→ {essay.data.title}
											</a>
										))}
									</div>
								</div>
							)}

							<!-- Decorative Corner (Hover only) -->
							<div class="absolute top-0 right-0 w-8 h-8 opacity-0 group-hover:opacity-100 transition-opacity">
								<div class="absolute top-4 right-4 w-[2px] h-4 bg-brand/20"></div>
								<div class="absolute top-4 right-4 h-[2px] w-4 bg-brand/20"></div>
							</div>
						</div>
						);
					})}
				</div>

                <!-- Pagination -->
                <Pagination page={page} />
			</div>
		</main>
		<Footer />
	</body>
</html>
