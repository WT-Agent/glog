---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import { SITE_TITLE } from '../consts';

// Ideally, this data would come from a NAS API or a localized JSON file
const photos = [
  {
    url: 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&q=80&w=1000',
    title: 'Morning Mist',
    location: 'NAS / Cloud Drive',
    date: '2026-01-18'
  },
  {
    url: 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&q=80&w=1000',
    title: 'Deep Forest',
    location: 'NAS / Forest Cam',
    date: '2026-01-15'
  },
  {
    url: 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&q=80&w=1000',
    title: 'Alpine Lake',
    location: 'NAS / Travel',
    date: '2026-01-10'
  }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Gallery | ${SITE_TITLE}`} description="Visual memories synced from private NAS." />
	</head>
	<body class="bg-background text-foreground antialiased selection:bg-primary/20">
		<Header />
		<main class="max-w-6xl mx-auto px-6 py-12 md:py-20 relative">
			<header class="mb-12 md:mb-16 text-center max-w-2xl mx-auto space-y-3">
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground">
					Gallery
				</h1>
				<p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
					A collection of visual moments, automatically synchronized from my private NAS storage.
				</p>
				<div class="pt-1">
					<span class="inline-flex items-center gap-1.5 px-3 py-1 bg-primary/10 text-primary border border-primary/20 text-xs font-semibold rounded-full uppercase tracking-wider">
						NAS Connected
					</span>
				</div>
			</header>

			<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{photos.map((photo) => (
					<div class="group relative aspect-[4/5] overflow-hidden rounded-2xl bg-card border border-border shadow-xs hover:border-primary/40 hover:-translate-y-1 transition-all duration-300">
						<img 
							src={photo.url} 
							alt={photo.title}
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
							<p class="text-primary font-mono text-xs mb-1 uppercase tracking-wider">{photo.location} • {photo.date}</p>
							<h3 class="text-xl font-bold text-white tracking-tight">{photo.title}</h3>
						</div>
					</div>
				))}
			</section>

			<footer class="mt-16 text-center">
				<div class="inline-flex flex-col items-center gap-3.5 p-8 rounded-2xl bg-card border border-border text-card-foreground shadow-xs max-w-md w-full">
					<p class="text-sm text-muted-foreground font-medium">Want to see more private archives?</p>
					<Button 
						href="mailto:nas@geniux.net" 
						variant="primary"
						size="sm"
					>
						Request Access
					</Button>
				</div>
			</footer>
		</main>
		<Footer />
	</body>
</html>
