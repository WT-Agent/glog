---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PodcastStatus from '../components/PodcastStatus.astro';

import Giscus from '../components/Giscus.astro';
import XReplies from '../components/XReplies.astro';

import RelatedPosts from '../components/RelatedPosts.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getRelatedProjectsForPost } from '../data/projects';

type Props = { 
	post?: CollectionEntry<'blog'>;
	headings?: { depth: number; slug: string; text: string }[];
	seriesPosts?: CollectionEntry<'blog'>[]; // Keep for legacy if needed, but we'll use RelatedPosts
	heroVariant?: 'banner' | 'avatar';
	title?: string;
	description?: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: any;
	tags?: string[];
	author?: string;
};

const { post, headings, heroVariant = 'banner', ...rest } = Astro.props;
const data = post ? post.data : rest;
const { title, description, pubDate, updatedDate, heroImage, tags, author } = data;
const id = post ? post.id : 'page';
const hasCjk = /[\u4e00-\u9fff]/.test(`${title || ''} ${description || ''} ${post?.body?.slice(0, 400) || ''}`);
const htmlLang = hasCjk ? 'zh-CN' : 'en';
const relatedProjects = post ? getRelatedProjectsForPost(post, 3) : [];
---

<html lang={htmlLang}>
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={heroImage} 
			article={{ pubDate, updatedDate, author }} 
		/>
	</head>

	<body class="bg-background text-foreground antialiased transition-colors duration-300">
		<div id="progress-bar" class="fixed top-0 left-0 h-0.5 bg-primary z-[60] transition-all duration-150 w-0"></div>
		<Header />
		
		<main class="w-full max-w-4xl lg:max-w-5xl xl:max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-10 md:py-16 animate-in fade-in duration-500 relative">
			<div class="flex flex-col items-center">
				<article class="w-full transition-all duration-300">
					<nav class="mb-8">
						<a href="/blog" class="group inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-all font-medium">
							<span class="transition-transform group-hover:-translate-x-1">←</span>
							<span>Back to Blog</span>
						</a>
					</nav>
					<header class="mb-10 text-center md:text-left relative">
						<div class="flex items-center gap-2 text-muted-foreground font-mono text-xs mb-3 justify-center md:justify-start">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="italic text-muted-foreground/80">
										(Updated on <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</div>
						<h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-balance mb-4 leading-snug">
							{title}
						</h1>
						{description && (
							<p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
								{description}
							</p>
						)}
					</header>

					{heroImage && (
						heroVariant === 'avatar' ? (
							<div class="w-40 h-40 sm:w-48 sm:h-48 mx-auto rounded-full overflow-hidden border-2 border-border shadow-xs mb-10 shrink-0 bg-muted">
								<Image width={400} height={400} src={heroImage} alt="" class="w-full h-full object-cover object-top" />
							</div>
						) : (
							<div class="rounded-2xl overflow-hidden border border-border shadow-xs mb-12 aspect-video shrink-0 bg-muted">
								<Image width={1020} height={510} src={heroImage} alt="" class="w-full h-full object-cover" />
							</div>
						)
					)}

					<TableOfContents headings={headings} />
					
					<div class="prose prose-lg dark:prose-invert max-w-none">
						<slot />
					</div>

					<div class="mt-14 flex flex-col gap-8 pt-8 border-t border-border">
						{author && (
							<div class="flex flex-col items-end self-end gap-1">
								<span class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">Written By</span>
								<div class="flex items-center gap-2">
									<div class="w-8 h-[1px] bg-border"></div>
									<span class="text-base font-semibold tracking-tight text-foreground">{author}</span>
								</div>
							</div>
						)}
						{tags && tags.length > 0 && (
							<div class="flex flex-wrap gap-2">
								{tags.map((tag) => (
									<a 
									  href={`/tags/${encodeURIComponent(tag)}`} 
									  class="text-xs font-medium px-3 py-1.5 bg-muted/60 hover:bg-accent hover:text-foreground rounded-lg text-muted-foreground transition-all border border-border/50"
									>
									  #{tag}
									</a>
								))}
							</div>
						)}
					</div>

					<PodcastStatus blogPostId={id} showDetails={false} />

					{relatedProjects.length > 0 && (
						<section class="mt-10 p-5 rounded-2xl bg-card/30 border border-border/60">
							<div class="flex items-center justify-between mb-3">
								<span class="text-[10px] font-mono font-semibold uppercase tracking-widest text-muted-foreground">
									<span class="lang-zh">关联项目</span>
									<span class="lang-en">Related Projects</span>
								</span>
								<a href="/projects" class="text-[11px] font-mono text-primary hover:underline">
									<span class="lang-zh">全部项目 →</span>
									<span class="lang-en">All Projects →</span>
								</a>
							</div>
							<div class="flex flex-wrap gap-2">
								{relatedProjects.map((proj) => (
									<a
										href={proj.link || '/projects'}
										target={proj.link ? '_blank' : undefined}
										rel={proj.link ? 'noopener noreferrer' : undefined}
										class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-muted/60 hover:bg-accent border border-border/50 text-xs font-medium text-foreground transition-colors"
									>
										<span class="lang-zh">{proj.zhTitle || proj.title}</span>
										<span class="lang-en">{proj.enTitle || proj.title}</span>
										{proj.link && <span class="text-muted-foreground text-[10px]">↗</span>}
									</a>
								))}
							</div>
						</section>
					)}

					{/* 1.9 Related Content & Series Navigation */}
					{post && <RelatedPosts post={post} />}

					<XReplies slug={id} />
					<Giscus />
				</article>

			</div>
		</main>
		<Footer />

		<script>
			// Reading Progress Bar
			const updateProgressBar = () => {
				const progressBar = document.getElementById('progress-bar');
				if (progressBar) {
					const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
					const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
					progressBar.style.width = `${progress}%`;
				}
			};

			document.addEventListener('astro:page-load', () => {
				window.addEventListener('scroll', updateProgressBar);
				updateProgressBar();
			});
		</script>
	</body>
</html>
